---
import Footer from "../../components/Footer.astro";
import Nav from "../../components/Nav.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";

const title = "Docs — Harness Dreams";
const description =
  "Documentation for the Harness Dreams tester MVP: local setup, Dream Score, code-flow, signals, privacy, and parked features.";

const sections = [
  {
    title: "Quick start",
    body: "Clone the repo, install dependencies with pnpm, and start the desktop tracker while the self-signed tester DMG is prepared.",
    href: "/start/",
  },
  {
    title: "Dream Score & Code Flow",
    body: "Understand the deterministic score, four components, stage graph, annotations, and score honesty rules.",
    href: "/docs/health-review/",
  },
  {
    title: "Privacy model",
    body: "What stays local, how share-card previews work, and why the tester MVP has no cloud sync surface.",
    href: "/privacy/",
  },
  {
    title: "MVP scope",
    body: "What is in the tester build, what is parked, and why advice cards never apply changes in this phase.",
    href: "/review/",
  },
];
---

<SiteLayout title={title} description={description}>
  <Nav />
  <main id="main">
    <section class="page-hero docs-hero">
      <div class="container page-hero-grid">
        <div>
          <span class="eyebrow">Docs</span>
          <h1>Understand the tester MVP before you run it.</h1>
          <p class="lead">
            The docs explain the actual product model: local ingestion, Dream
            Score math, code-flow stages, deterministic trends, share-card
            privacy, and the features deliberately parked for later.
          </p>
        </div>
        <figure class="page-visual">
          <img
            src="/story-standing-desk.png"
            alt="A modern San Francisco standing desk with multiple monitors, laptop, phone, and subtle health-style workflow cards."
            loading="eager"
            decoding="async"
          />
        </figure>
      </div>
    </section>

    <section class="section">
      <div class="container doc-grid">
        {
          sections.map((section) => (
            <a class="doc-card reveal" href={section.href}>
              <h2>{section.title}</h2>
              <p>{section.body}</p>
              <span>Read guide →</span>
            </a>
          ))
        }
      </div>
    </section>
  </main>
  <Footer />
</SiteLayout>
