---
import Footer from "../../components/Footer.astro";
import Nav from "../../components/Nav.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";

const title = "Case Studies — Harness Dreams";
const description =
  "Realistic case studies showing how Harness Dreams turns agent-session telemetry into Dream Score movement, code-flow stories, quotes, and advice cards.";

const studies = [
  {
    title: "Agent-fleet revealed an alignment drag",
    href: "/case-studies/agent-fleet/",
    metric: "Alignment 64 → 81",
    text: "A cluster of rapid re-asks showed up in Code Flow and pulled the Dream Score down. The coach card suggested one setup habit, not an automatic patch.",
  },
  {
    title: "UI work kept flow while using fewer tokens",
    href: "/case-studies/ui-review-cost/",
    metric: "~12% fewer tokens",
    text: "Estimated and real token counters showed bounded UI passes consuming too much context. Efficiency improved without touching the score with fake cost data.",
  },
  {
    title: "A duplicate-parser loop became a quote and a trend",
    href: "/case-studies/shared-parser-helper/",
    metric: "2 repos, same shape",
    text: "Browse grouped the repeated parser work under Volume & Usage, while a memorable agent thought made the loop easy to discuss.",
  },
];
---

<SiteLayout title={title} description={description}>
  <Nav />
  <main id="main">
    <section class="page-hero">
      <div class="container page-hero-grid">
        <div>
          <span class="eyebrow">Case studies</span>
          <h1>What tracker-first harness health looks like.</h1>
          <p class="lead">
            These stories are based on the product’s mock telemetry model, but
            they reflect the concrete patterns Harness Dreams is built to find:
            score dips, recognizable day shapes, quote-worthy moments, and
            advice cards grounded in real evidence.
          </p>
        </div>
        <figure class="page-visual">
          <img
            src="/story-team-standup.png"
            alt="Two developers in a clean San Francisco office reviewing harness health improvements at a shared monitor."
            loading="eager"
            decoding="async"
          />
        </figure>
      </div>
    </section>

    <section class="section">
      <div class="container resource-grid">
        {
          studies.map((study, i) => (
            <a class="resource-card reveal" data-delay={String((i % 3) + 1)} href={study.href}>
              <span class="mono">Case study</span>
              <h2>{study.title}</h2>
              <p>{study.text}</p>
              <small>{study.metric} →</small>
            </a>
          ))
        }
      </div>
    </section>
  </main>
  <Footer />
</SiteLayout>
