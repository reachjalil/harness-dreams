---
import CTA from "../components/CTA.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import SiteLayout from "../layouts/SiteLayout.astro";

const title = "Dream Score & Code Flow — Harness Dreams";
const description =
  "A tour of the Harness Dreams tracker: Dream Score, code-Code Flow graph, pinned metrics, trends, highlights, quotes, and ambient advice.";

const stages = [
  {
    label: "Score",
    title: "A deterministic Dream Score",
    text: "Alignment, effectiveness, efficiency, and rhythm combine into one comparable number. LLMs never write or override the score.",
  },
  {
    label: "Code Flow",
    title: "Sleep stages for your coding day",
    text: "Five-minute buckets become Deep Focus, Rapid Exchange, Agent Running, Light Touch, or Rest, with annotations for switches and spikes.",
  },
  {
    label: "Browse",
    title: "Every metric has a detail page",
    text: "Dream Score, Code Flow, Alignment, Effectiveness, Efficiency, Rhythm, Volume, and Quotes are grouped like Health categories.",
  },
  {
    label: "Quote",
    title: "The funny and revealing moments survive",
    text: "Top user quotes and agent thoughts are selected deterministically, redacted at display time, and ready for share cards.",
  },
  {
    label: "Coach",
    title: "Advice stays small and anchored",
    text: "At most three coach cards appear, each tied to a visible score component, trend, quote, or code-flow moment. Nothing is applied.",
  },
];

const actions = [
  "Show the exact inputs behind the Dream Score components.",
  "Open any past day as a frozen Summary with final score and graph.",
  "Export a previewed share card with score, Code Flow, one stat, and one quote.",
  "Dismiss or snooze coach cards without changing local project config.",
];
---

<SiteLayout title={title} description={description}>
  <Nav />
  <main id="main">
    <section class="page-hero review-page">
      <div class="container page-hero-grid">
        <div>
          <span class="eyebrow">Product tour</span>
          <h1>The Dream Score is the front door.</h1>
          <p class="lead">
            The MVP is not a report ceremony. It is a living tracker: one score
            you can compare, one graph that makes the day recognizable, and a
            few grounded notes when the data has something useful to say.
          </p>
        </div>

        <figure
          class="page-visual tracker-visual"
          aria-label="Harness Dreams tracker mock showing Dream Score, Code Flow, quotes, and local status."
        >
          <div class="tracker-frame">
            <div class="tracker-topbar">
              <span></span>
              <span></span>
              <span></span>
              <strong>Summary</strong>
            </div>
            <div class="tracker-summary">
              <div class="tracker-score" style="--score: 84%">
                <span>84</span>
                <small>Dream Score</small>
              </div>
              <div class="tracker-note">
                <span>Today</span>
                <strong>Focused, with one retry loop.</strong>
                <p>Deep Focus carried the morning. Alignment dipped after a repeated parser request.</p>
              </div>
            </div>
            <div class="tracker-flow" aria-hidden="true">
              <span style="--w: 14%; --tone: var(--dusk)"></span>
              <span style="--w: 10%; --tone: var(--teal-deep)"></span>
              <span style="--w: 18%; --tone: var(--dusk)"></span>
              <span style="--w: 8%; --tone: var(--iris)"></span>
              <span style="--w: 12%; --tone: rgba(74, 108, 247, 0.2)"></span>
              <span style="--w: 17%; --tone: var(--dusk)"></span>
              <span style="--w: 9%; --tone: var(--teal-deep)"></span>
            </div>
            <div class="tracker-rows">
              <div>
                <span>Quote pinned</span>
                <strong>"This finally explains the loop."</strong>
              </div>
              <div>
                <span>Coach</span>
                <strong>2 advice cards, no project writes</strong>
              </div>
              <div>
                <span>Storage</span>
                <strong>Local-only on this Mac</strong>
              </div>
            </div>
          </div>
        </figure>
      </div>
    </section>

    <section class="section">
      <div class="container split-layout">
        <div class="sticky-copy reveal">
          <span class="eyebrow">Like a health app for agents</span>
          <h2 class="h2">Familiar surfaces, agent-native metrics.</h2>
          <p class="lead">
            Summary, Browse, History, Sharing, and Profile give the product a
            shape testers already understand. The metrics are new; the shell
            should feel obvious.
          </p>
        </div>

        <div class="timeline-stack">
          {
            stages.map((stage, i) => (
              <article class="timeline-card reveal" data-delay={String((i % 3) + 1)}>
                <span class="timeline-index">{String(i + 1).padStart(2, "0")}</span>
                <div>
                  <span class="mono">{stage.label}</span>
                  <h3>{stage.title}</h3>
                  <p>{stage.text}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section night-band">
      <div class="container">
        <div class="section-narrow reveal">
          <span class="eyebrow">Tracker contract</span>
          <h2 class="h2">The score explains what happened. The coach suggests what to try.</h2>
          <p class="lead">
            Numbers are pure local math. Trends and highlights are deterministic
            comparisons. The coach may use local runner wording, but the trigger
            and evidence are always visible first.
          </p>
        </div>
        <div class="action-grid">
          {actions.map((action) => <div class="action-tile">{action}</div>)}
        </div>
      </div>
    </section>

    <CTA />
  </main>
  <Footer />
</SiteLayout>
