---
import Footer from "../../components/Footer.astro";
import Nav from "../../components/Nav.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";

const title = "Blog — Harness Dreams";
const description =
  "Essays about Harness Dreams, tracker-first AI telemetry, deterministic Dream Scores, code-flow, local privacy, and agent quotes.";

const posts = [
  {
    title: "Why AI coding agents need a health app",
    href: "/blog/harness-health-app/",
    date: "Product note",
    text: "A coding agent can be fast and still create an unhealthy collaboration loop. The useful signal is longitudinal.",
  },
  {
    title: "Why the morning report became a tracker",
    href: "/blog/morning-report-rule/",
    date: "Design note",
    text: "The MVP moves from review ritual to passive Summary, Browse, History, Sharing, and a few ambient coach cards.",
  },
  {
    title: "Local-first telemetry for agent workflows",
    href: "/blog/local-first-telemetry/",
    date: "Architecture note",
    text: "Session data is sensitive. The default posture should be local, inspectable, and useful before any server exists.",
  },
];
---

<SiteLayout title={title} description={description}>
  <Nav />
  <main id="main">
    <section class="page-hero">
      <div class="container page-hero-grid">
        <div>
          <span class="eyebrow">Blog</span>
          <h1>Notes from the Dream Score lab.</h1>
          <p class="lead">
            Short essays on the product idea behind Harness Dreams: calmer
            agent telemetry, deterministic scoring, local-first privacy, and
            the parts of AI work that are actually worth sharing.
          </p>
        </div>
        <figure class="page-visual">
          <img
            src="/story-mobile-review.png"
            alt="A developer walking through a bright San Francisco office lobby while reviewing a morning harness health report on a phone."
            loading="eager"
            decoding="async"
          />
        </figure>
      </div>
    </section>

    <section class="section">
      <div class="container resource-grid">
        {
          posts.map((post, i) => (
            <a class="resource-card reveal" data-delay={String((i % 3) + 1)} href={post.href}>
              <span class="mono">{post.date}</span>
              <h2>{post.title}</h2>
              <p>{post.text}</p>
              <small>Read article →</small>
            </a>
          ))
        }
      </div>
    </section>
  </main>
  <Footer />
</SiteLayout>
