---
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import SiteLayout from "../layouts/SiteLayout.astro";

const title = "Request Early Access - Harness Dreams";
const description =
  "Request early access to the Harness Dreams private preview for Claude Code and Codex on macOS.";
---

<SiteLayout title={title} description={description} themeColor="#0b0d34">
  <Nav theme="night" />
  <main id="main">
    <section class="access-hero">
      <div class="access-sky" aria-hidden="true">
        <div class="starscape"></div>
        <span></span>
        <span></span>
      </div>

      <div class="container access-grid">
        <div class="access-copy">
          <span class="eyebrow">Private preview</span>
          <h1>Request early access.</h1>
          <p class="lead">
            Harness Dreams is running a private macOS preview for people using
            Claude Code and Codex in real work. Share your email and we will be
            in touch with next steps.
          </p>
          <p class="access-note">
            We are bringing testers in carefully through TestFlight so we can
            learn from real agent sessions, tune the Health signals, and keep
            the preview experience sharp.
          </p>
        </div>

        <aside class="access-panel" aria-label="Request early access">
          <div class="panel-head">
            <span class="mono">Early access</span>
            <span class="preview-pill">TestFlight</span>
          </div>

          <h2>Join the private preview</h2>
          <p>
            Leave your email and we will follow up if your workflow is a fit for
            the current TestFlight cohort.
          </p>

          <form class="access-form" id="early-access-form" novalidate>
            <label for="access-email">Email address</label>
            <div class="field-row">
              <input
                id="access-email"
                name="email"
                type="email"
                inputmode="email"
                autocomplete="email"
                placeholder="you@company.com"
                required
              />
              <button class="btn btn-primary" type="submit">
                Request access
              </button>
            </div>
            <div class="hp" aria-hidden="true">
              <label for="access-company">Company</label>
              <input
                id="access-company"
                name="company"
                type="text"
                tabindex="-1"
                autocomplete="off"
              />
            </div>
          </form>

          <p class="form-note" id="access-form-note" role="status" aria-live="polite">
            Private preview only. We will email you with TestFlight details when
            a spot opens.
          </p>

          <div class="preview-steps" aria-label="Preview process">
            <div>
              <span class="step-index mono">01</span>
              <strong>Request access</strong>
              <p>Tell us where to reach you.</p>
            </div>
            <div>
              <span class="step-index mono">02</span>
              <strong>We review fit</strong>
              <p>We prioritize active Claude Code and Codex users.</p>
            </div>
            <div>
              <span class="step-index mono">03</span>
              <strong>TestFlight invite</strong>
              <p>Selected testers get the macOS preview path.</p>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <section class="section status-section" id="preview">
      <div class="container status-grid">
        <article class="info-block reveal">
          <span class="mono">What we need</span>
          <h2>Real AI coding sessions.</h2>
          <p>
            The preview is most useful for people with active Claude Code or
            Codex history, including smooth days, stuck loops, and moments where
            the agent workflow clearly changed.
          </p>
        </article>

        <article class="info-block reveal" data-delay="1">
          <span class="mono">What you get</span>
          <h2>A private macOS build.</h2>
          <p>
            Testers receive guided access to the Harness Dreams preview and help
            shape the Dream Score, session timelines, quotes, and health signals
            before a public release.
          </p>
        </article>

        <article class="info-block reveal" data-delay="2">
          <span class="mono">What stays true</span>
          <h2>Local-first and careful.</h2>
          <p>
            The product is still being tested. We are inviting people gradually,
            learning from feedback, and keeping the preview focused on the
            desktop agent workflow.
          </p>
        </article>
      </div>
    </section>
  </main>
  <Footer />
</SiteLayout>

<style>
  .access-hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
    padding-block: clamp(7rem, 10vw, 8.5rem) clamp(3rem, 6vw, 4.5rem);
    background:
      radial-gradient(
        110% 60% at 50% 112%,
        rgba(214, 222, 255, 0.36),
        transparent 62%
      ),
      linear-gradient(
        160deg,
        #07092a 0%,
        var(--night) 30%,
        var(--night-2) 70%,
        var(--night-3) 100%
      );
    color: #fff;
  }

  .access-hero::before,
  .access-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .access-hero::before {
    background: radial-gradient(
      55% 65% at 82% 6%,
      rgba(122, 90, 240, 0.4),
      transparent 68%
    );
    opacity: 0.8;
  }

  .access-hero::after {
    background: radial-gradient(
      circle at 76% 24%,
      rgba(255, 255, 255, 0.18),
      transparent 34%
    );
    opacity: 0.8;
  }

  .access-sky {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
  }

  .access-sky span {
    position: absolute;
    left: -18vw;
    width: 136vw;
    height: clamp(15rem, 31vw, 28rem);
    border-radius: 999px;
    filter: blur(7px);
    mix-blend-mode: screen;
    background:
      radial-gradient(
        ellipse at 22% 48%,
        rgba(255, 255, 255, 0.24),
        transparent 38%
      ),
      linear-gradient(92deg, transparent, rgba(255, 255, 255, 0.16), transparent);
  }

  .access-sky span:first-of-type {
    top: 12vh;
    transform: rotate(-8deg);
  }

  .access-sky span:last-of-type {
    top: 48vh;
    opacity: 0.7;
    transform: rotate(-12deg);
  }

  .access-grid {
    position: relative;
    z-index: 2;
    display: grid;
    gap: clamp(2rem, 6vw, 4rem);
    align-items: center;
  }

  .access-copy {
    display: grid;
    gap: 1rem;
  }

  .access-copy .eyebrow {
    color: var(--gold-bright);
  }

  .access-copy h1 {
    max-width: 11ch;
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(2.7rem, 5.4vw, 4.75rem);
    font-weight: 540;
    letter-spacing: -0.026em;
    line-height: 1.02;
  }

  .access-copy .lead {
    max-width: 38rem;
    color: rgba(255, 255, 255, 0.84);
    font-size: clamp(1.02rem, 1.45vw, 1.18rem);
    font-weight: 650;
    line-height: 1.42;
  }

  .access-note {
    max-width: 36rem;
    color: rgba(255, 255, 255, 0.66);
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.45;
  }

  .access-panel {
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 28px;
    background:
      linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.17),
        rgba(255, 255, 255, 0.07)
      ),
      rgba(255, 255, 255, 0.08);
    box-shadow: 0 26px 80px -48px rgba(0, 0, 0, 0.58);
    backdrop-filter: blur(24px) saturate(130%);
    -webkit-backdrop-filter: blur(24px) saturate(130%);
    padding: clamp(1.25rem, 2.8vw, 1.8rem);
  }

  .panel-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .panel-head .mono {
    color: rgba(255, 255, 255, 0.94);
  }

  .preview-pill {
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    padding: 0.38rem 0.72rem;
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    font-weight: 750;
    font-size: 0.82rem;
  }

  .access-panel h2 {
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 3vw, 2.15rem);
    font-weight: 600;
    letter-spacing: -0.014em;
    line-height: 1.1;
  }

  .access-panel > p {
    margin-top: 0.65rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.5;
  }

  .access-form {
    display: grid;
    gap: 0.55rem;
    margin-top: 1.25rem;
  }

  .access-form label {
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.86rem;
    font-weight: 750;
  }

  .field-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  input[type="email"] {
    flex: 1 1 15rem;
    min-width: 0;
    padding: 0.82rem 1rem;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.07);
    color: #ffffff;
    font-family: inherit;
    font-size: 0.98rem;
  }

  input[type="email"]::placeholder {
    color: rgba(255, 255, 255, 0.45);
  }

  input[type="email"]:focus-visible {
    outline: 3px solid rgba(122, 90, 240, 0.5);
    outline-offset: 1px;
    border-color: rgba(255, 255, 255, 0.42);
  }

  .field-row button {
    flex: 0 0 auto;
    background: #fff;
    color: var(--night);
    box-shadow: 0 16px 40px -20px rgba(2, 5, 18, 0.8);
  }

  .field-row button:hover {
    background: rgba(255, 255, 255, 0.92);
    color: var(--night);
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form-note {
    color: rgba(255, 255, 255, 0.58);
    font-size: 0.86rem;
  }

  .form-note.ok {
    color: var(--teal);
  }

  .form-note.err {
    color: #ff9b8b;
  }

  .preview-steps {
    display: grid;
    gap: 0.8rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .preview-steps div {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 0.75rem;
    align-items: start;
  }

  .step-index {
    grid-row: span 2;
    color: var(--gold-bright);
    padding-top: 0.1rem;
  }

  .preview-steps strong {
    color: #fff;
    font-size: 0.98rem;
  }

  .preview-steps p {
    color: rgba(255, 255, 255, 0.62);
    font-size: 0.88rem;
    line-height: 1.4;
  }

  .status-section {
    background:
      linear-gradient(180deg, var(--bg), rgba(222, 215, 199, 0.24)), var(--bg);
  }

  .status-grid {
    display: grid;
    gap: 1rem;
  }

  .info-block {
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-soft);
    padding: clamp(1.3rem, 3vw, 1.8rem);
  }

  .info-block h2 {
    margin-top: 0.65rem;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3vw, 1.85rem);
    font-weight: 600;
    letter-spacing: -0.014em;
    line-height: 1.14;
  }

  .info-block p {
    color: var(--muted);
    margin-top: 0.75rem;
  }

  @media (min-width: 900px) {
    .access-grid {
      grid-template-columns: minmax(0, 0.86fr) minmax(25rem, 0.9fr);
    }

    .status-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .access-hero {
      min-height: auto;
    }

    .access-copy h1 {
      max-width: 10ch;
    }

    .field-row button {
      width: 100%;
    }
  }
</style>

<script>
  const FORM_ENDPOINT = "/api/waitlist";

  const form = document.getElementById(
    "early-access-form",
  ) as HTMLFormElement | null;
  const note = document.getElementById("access-form-note");
  const input = document.getElementById("access-email") as HTMLInputElement | null;
  const honeypot = document.getElementById(
    "access-company",
  ) as HTMLInputElement | null;

  function setNote(msg: string, kind: "" | "ok" | "err") {
    if (!note) return;
    note.textContent = msg;
    note.classList.remove("ok", "err");
    if (kind) note.classList.add(kind);
  }

  const valid = (value: string) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const email = input?.value.trim() ?? "";

    if (!valid(email)) {
      setNote("Please enter a valid email address.", "err");
      input?.focus();
      return;
    }

    try {
      const response = await fetch(FORM_ENDPOINT, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          email,
          company: honeypot?.value ?? "",
          src: "early-access",
        }),
      });
      if (!response.ok) throw new Error("bad status");
      form.reset();
      setNote(
        "You're on the private preview list. We will be in touch with TestFlight details.",
        "ok",
      );
    } catch {
      setNote("Something went wrong. Please try again in a moment.", "err");
    }
  });
</script>
