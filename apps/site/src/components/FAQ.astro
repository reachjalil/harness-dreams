---
const faqs = [
  {
    q: "Which coding agents does it support?",
    a: "The private preview focuses on Claude Code and Codex on macOS. Claude Code provides real usage fields; Codex gets honest estimated tokens so its days never show fake zeros.",
  },
  {
    q: "Does my code leave my machine?",
    a: "No. Transcripts are read on your Mac, scores are computed on your Mac, and share cards are exported only after you preview them. There is no cloud sync surface in this build.",
  },
  {
    q: "Does it change my agent setup?",
    a: "Not in the preview. Coach cards can suggest an instruction, workflow habit, or snippet to copy, but the app does not edit AGENTS.md, memory, branches, or PRs.",
  },
  {
    q: "Is this another analytics dashboard?",
    a: "No. It is built around a daily workflow: one Dream Score, pinned cards, a code-flow timeline, deterministic trends, a few highlights, quotes worth saving, and at most three advice cards.",
  },
  {
    q: "What will it cost?",
    a: "The private preview is not a paid public launch. The current path is a source or self-signed macOS build while the product proves the desktop workflow.",
  },
  {
    q: "What platform does it run on?",
    a: "macOS first. Mobile, watch, cloud sync, payments, and additional agent connectors wait until the desktop workflow is proven.",
  },
];
---

<section class="section" id="faq">
  <div class="container">
    <div class="head section-narrow reveal">
      <span class="eyebrow">Questions</span>
      <h2 class="h2">Questions builders usually ask first.</h2>
    </div>

    <div class="faq-list section-narrow">
      {
        faqs.map((f, i) => (
          <details class="faq reveal" data-delay={((i % 3) + 1).toString()}>
            <summary>
              <span>{f.q}</span>
              <span class="chev" aria-hidden="true">+</span>
            </summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .head {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .faq-list {
    display: grid;
    gap: 0.7rem;
  }
  .faq {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.3rem;
    cursor: pointer;
    font-weight: 600;
    font-size: 1.02rem;
    letter-spacing: 0;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:focus-visible {
    outline: 3px solid rgba(74, 108, 247, 0.4);
    outline-offset: -3px;
    border-radius: var(--radius);
  }
  .chev {
    flex: none;
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    border-radius: 7px;
    background: rgba(74, 108, 247, 0.1);
    color: var(--accent);
    font-size: 1.1rem;
    line-height: 1;
    transition: transform 0.2s ease;
  }
  .faq[open] .chev {
    transform: rotate(45deg);
  }
  .faq p {
    padding: 0 1.3rem 1.2rem;
    color: var(--muted);
    font-size: 0.97rem;
    line-height: 1.55;
    max-width: 70ch;
  }
</style>
