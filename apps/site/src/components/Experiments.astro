---
const stages = [
  {
    k: "Trigger",
    t: "A score component, trend, quote, or Code Flow marker crosses a deterministic threshold.",
    tone: "cool",
  },
  {
    k: "Anchor",
    t: "The card links back to the exact metric or moment, so the suggestion has receipts.",
    tone: "cool",
  },
  {
    k: "Suggest",
    t: "The coach offers one concrete habit or copyable snippet. It never applies the change.",
    tone: "warm",
  },
  {
    k: "Quiet",
    t: "Dismissed cards stay gone unless the underlying signal worsens materially.",
    tone: "warm",
  },
];
---

<section class="section exp-section" id="experiments">
  <div class="container">
    <div class="exp-grid">
      <div class="exp-copy reveal">
        <span class="eyebrow">Ambient coach</span>
        <h2 class="h2">Advice earns its spot.</h2>
        <p class="lead">
          The MVP caps advice at three cards and every card must point to
          visible evidence. Trends and highlights do the teaching first; the
          coach only phrases what the tracker already found.
        </p>
        <p class="kicker">
          No experiments engine, no automatic config edits, no branches. If
          testers ask for "apply this for me," that is the signal to bring the
          parked patch machinery back later.
        </p>
      </div>

      <ol class="flow reveal" data-delay="1">
        {
          stages.map((s, i) => (
            <li class={`stage ${s.tone}`}>
              <span class="step-n mono">{`0${i + 1}`}</span>
              <div>
                <div class={`k ${s.tone}`}>{s.k}</div>
                <p>{s.t}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .exp-section {
    border-block: 1px solid var(--line);
    background: radial-gradient(
      80% 90% at 80% 10%,
      rgba(122, 90, 240, 0.07),
      transparent 60%
    );
  }
  .exp-grid {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
  }
  .exp-copy {
    display: grid;
    gap: 1.1rem;
  }
  .exp-copy .kicker {
    font-size: 0.98rem;
  }
  .exp-copy b {
    color: var(--text);
  }
  .flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }
  .stage {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.9rem;
    align-items: start;
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .step-n {
    color: var(--faint);
    padding-top: 0.15rem;
  }
  .k {
    font-weight: 650;
    font-size: 0.92rem;
    margin-bottom: 0.25rem;
    color: var(--accent);
  }
  .k.warm {
    color: var(--warm);
  }
  .stage p {
    color: var(--muted);
    font-size: 0.93rem;
  }
  @media (min-width: 920px) {
    .exp-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
