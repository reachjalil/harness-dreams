---
/**
 * Quiet Orbit brand mark: a crescent moon with a small orb traveling its path.
 * Reusable at any size/color.
 */
interface Props {
  size?: number;
  moon?: string;
  orbit?: string;
  planet?: string;
  animated?: boolean;
  label?: string;
}
const {
  size = 28,
  moon = "#ffffff",
  orbit = "#ffffff",
  planet = "#ffffff",
  animated = false,
  label = "Harness Dreams",
} = Astro.props as Props;

// Unique mask id so multiple marks on one page don't collide.
const uid = `bm-${Math.random().toString(36).slice(2, 8)}`;
const planetBackPath =
  "M 58.5 35.8 C 58.5 30.4 46.6 26.05 32 26.05 C 17.4 26.05 5.5 30.4 5.5 35.8";
const planetFrontPath =
  "M 5.5 35.8 C 5.5 41.2 17.4 45.55 32 45.55 C 46.6 45.55 58.5 41.2 58.5 35.8";
const orbitFrontPath =
  "M 6.2 35.8 C 7.1 41.3 18.4 45.55 32 45.55 C 46.6 45.55 58.5 41.2 58.5 35.8";
---

<svg
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  class:list={["brand-mark", { "brand-mark-animated": animated }]}
  role="img"
  aria-label={label}
>
  <mask id={uid} x="0" y="0" width="64" height="64" maskUnits="userSpaceOnUse">
    <rect width="64" height="64" fill="white"></rect>
    <circle cx="43.4" cy="25.4" r="21.4" fill="black"></circle>
  </mask>
  <g class="brand-orbit brand-orbit-back" transform="rotate(-18 32 35.8)">
    <ellipse
      cx="32"
      cy="35.8"
      rx="26.5"
      ry="9.75"
      fill="none"
      stroke={orbit}
      stroke-width="1.6"></ellipse>
    {
      animated ? (
        <g class="brand-planet-motion brand-planet-back">
          <circle class="brand-planet" cx="0" cy="0" r="4.35" fill={planet} />
          <animate
            attributeName="opacity"
            dur="16s"
            repeatCount="indefinite"
            values="1;1;0;0;1"
            keyTimes="0;0.499;0.5;0.999;1"
          />
          <animateMotion
            dur="16s"
            repeatCount="indefinite"
            calcMode="linear"
            keyPoints="0;1;1"
            keyTimes="0;0.5;1"
            path={planetBackPath}
          />
        </g>
      ) : null
    }
  </g>
  <circle
    class="brand-moon-shadow"
    cx="30.2"
    cy="32.8"
    r="22.5"
    fill={moon}
    opacity="0.16"
    mask={`url(#${uid})`}></circle>
  <circle
    class="brand-moon"
    cx="30.2"
    cy="32.8"
    r="22.5"
    fill={moon}
    mask={`url(#${uid})`}></circle>
  <g class="brand-orbit brand-orbit-front" transform="rotate(-18 32 35.8)">
    <path
      d={orbitFrontPath}
      fill="none"
      stroke={orbit}
      stroke-width="1.6"
      stroke-linecap="round"></path>
  </g>
  <g class="brand-orbit brand-orbit-front" transform="rotate(-18 32 35.8)">
    <circle
      class:list={[
        "brand-planet",
        "brand-planet-front",
        "brand-planet-static",
        { "hide-when-animated": animated },
      ]}
      cx="58.5"
      cy="35.8"
      r="4.35"
      fill={planet}
      stroke="rgba(9, 5, 36, 0.58)"
      stroke-width="0.9"></circle>
    {
      animated ? (
        <g class="brand-planet-motion brand-planet-front">
          <circle
            class="brand-planet"
            cx="0"
            cy="0"
            r="4.35"
            fill={planet}
            stroke="rgba(9, 5, 36, 0.58)"
            stroke-width="0.9"
          />
          <animate
            attributeName="opacity"
            dur="16s"
            repeatCount="indefinite"
            values="0;0;1;1;0"
            keyTimes="0;0.499;0.5;0.999;1"
          />
          <animateMotion
            dur="16s"
            repeatCount="indefinite"
            calcMode="linear"
            keyPoints="0;0;1"
            keyTimes="0;0.5;1"
            path={planetFrontPath}
          />
        </g>
      ) : null
    }
  </g>
</svg>

<style>
  .brand-mark {
    display: block;
    overflow: visible;
  }

  .brand-planet {
    filter: drop-shadow(0 0 1.2px rgba(255, 255, 255, 0.2));
  }

  .brand-planet-back,
  .brand-planet-back .brand-planet {
    filter: none;
  }

  .brand-planet-motion {
    transform-box: view-box;
  }

  .brand-mark-animated .hide-when-animated {
    opacity: 0;
  }

  .brand-moon {
    filter: drop-shadow(0 0 0.8px rgba(255, 255, 255, 0.2));
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-mark-animated .brand-planet-motion {
      display: none;
    }

    .brand-mark-animated .hide-when-animated {
      opacity: 1;
    }
  }
</style>
