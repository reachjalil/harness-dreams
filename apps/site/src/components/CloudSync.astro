---
const benefits = [
  {
    title: "Passive ingest",
    body: "Claude Code and Codex sessions are read automatically. Summary updates throughout the day and the menu bar keeps the score one click away.",
  },
  {
    title: "Performance surfaces",
    body: "Summary, Browse, History, Sharing, Profile, and onboarding all make agent work readable without forcing another analytics dashboard.",
  },
  {
    title: "No cloud dependency yet",
    body: "No mobile companion, payments, backend sync, or config patching in the preview. Advice can show a snippet to copy; it never applies changes.",
  },
];
---

<section class="section" id="tester-mvp">
  <div class="container">
    <div class="cloudsync card reveal">
      <div class="cs-copy">
        <span class="eyebrow cs-eyebrow">Private preview scope</span>
        <h2 class="h2">Start with the desktop system of record.</h2>
        <p class="lead">
          The first release proves one habit: a local macOS product can make AI
          coding sessions legible, comparable, and worth opening every day
          before cloud or mobile surfaces arrive.
        </p>
        <div class="cs-price">
          <span class="cs-amount">0<span> servers required</span></span>
          <span class="cs-price-note">
            Preview users run a source or self-signed build. Share cards export
            manually, human to human.
          </span>
        </div>
        <div class="cs-actions">
          <a class="btn btn-primary" href="/start/">Request early access</a>
          <span class="cs-soon">Cloud sync and mobile wait until the desktop workflow is proven.</span>
        </div>
      </div>

      <ul class="cs-list">
        {
          benefits.map((b, i) => (
            <li class="reveal" data-delay={((i % 3) + 1).toString()}>
              <span class="cs-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M17.5 19a4.5 4.5 0 0 0 .5-8.97A6 6 0 0 0 6.34 9.5 4 4 0 0 0 7 17.5" />
                  <path d="M12 12v6m0 0 2.5-2.5M12 18l-2.5-2.5" />
                </svg>
              </span>
              <div>
                <h3>{b.title}</h3>
                <p>{b.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .cloudsync {
    padding: clamp(1.75rem, 4vw, 2.75rem);
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    background:
      radial-gradient(70% 90% at 100% 0%, rgba(122, 90, 240, 0.1), transparent 55%),
      linear-gradient(180deg, var(--surface), rgba(255, 255, 255, 0));
  }
  .cs-copy {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
    align-content: start;
  }
  .cs-eyebrow {
    color: var(--iris);
  }
  .cs-price {
    display: grid;
    gap: 0.3rem;
  }
  .cs-amount {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2rem, 4vw, 2.6rem);
    line-height: 1;
    color: var(--ink);
  }
  .cs-amount span {
    font-size: 1rem;
    font-weight: 600;
    color: var(--muted);
  }
  .cs-price-note {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .cs-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem;
  }
  .cs-soon {
    color: var(--faint);
    font-size: 0.88rem;
  }
  .cs-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.1rem;
    align-content: start;
  }
  .cs-list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.85rem;
    align-items: start;
  }
  .cs-mark {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 9px;
    background: rgba(122, 90, 240, 0.12);
    border: 1px solid var(--line);
    color: var(--iris);
    flex: none;
  }
  .cs-list h3 {
    font-size: 1rem;
    font-weight: 640;
    margin-bottom: 0.2rem;
  }
  .cs-list p {
    color: var(--muted);
    font-size: 0.93rem;
  }
  @media (min-width: 880px) {
    .cloudsync {
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }
  }
</style>
