---
import Rings from "./Rings.astro";

const loops = [
  {
    label: "Dream Score",
    title: "Score the quality of every agent day.",
    text: "Alignment, effectiveness, efficiency, and rhythm roll into one comparable 0-100 signal. Tokens and hours stay visible without distorting the score.",
    score: "87",
    caption: "Dream Score",
    type: "rings",
  },
  {
    label: "Code Flow",
    title: "See how the work actually moved.",
    text: "A timeline labels deep focus, rapid exchange, autonomous agent runs, light touch, and rest so the day becomes explainable at a glance.",
    score: "2h 40m",
    caption: "deep focus",
    type: "bars",
  },
  {
    label: "Quotes & Thoughts",
    title: "Turn transcripts into useful signal.",
    text: "The best user quotes and agent thoughts become redacted, local-only cards you can review, share, or use to improve the next session.",
    score: "Top 3",
    caption: "today",
    type: "pulse",
  },
];
---

<section class="apple-story apple-story-white daily-optimization" id="daily">
  <div class="apple-copy reveal">
    <span class="health-glyph glyph-blue" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </span>
    <h2>Get the right data to continuously improve.</h2>
    <p>
      Harness Dreams turns your AI coding sessions into clear signals:
      <strong>scores, Code Flow timelines, quotes, trends, and next steps</strong>
      that show what is working and what needs attention.
    </p>
  </div>

  <div class="optimization-slider" aria-label="Daily optimization cards">
    {
      loops.map((loop, i) => (
        <article class="optimization-card reveal" data-delay={String(i + 1)}>
          <div class={`optimization-visual visual-${loop.type}`} aria-hidden="true">
            {loop.type === "rings" ? (
              <div class="desktop-score score-only">
                <Rings efficiency={84} effectiveness={69} alignment={76} />
                <strong>{loop.score}</strong>
              </div>
            ) : loop.type === "bars" ? (
              <div class="graph-tile">
                <div class="graph-bars">
                  <i></i><i></i><i></i><i></i><i></i><i></i>
                </div>
                <strong>{loop.score}</strong>
                <span>{loop.caption}</span>
              </div>
            ) : (
              <div class="pulse-tile">
                <svg viewBox="0 0 220 100">
                  <path d="M4 56h38l12-24 20 52 23-72 25 44h42l14-18 14 30 22-46"></path>
                </svg>
                <strong>{loop.score}</strong>
                <span>{loop.caption}</span>
              </div>
            )}
          </div>
          <div class="optimization-copy">
            <span>{loop.label}</span>
            <h3>{loop.title}</h3>
            <p>{loop.text}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
