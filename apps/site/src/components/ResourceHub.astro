---
const resources = [
  {
    eyebrow: "Dream Score",
    title: "See how the score explains agent work",
    text: "Walk through the score, code-flow timeline, quotes, trends, highlights, and evidence-backed next steps.",
    href: "/review/",
    meta: "Product tour",
  },
  {
    eyebrow: "Case studies",
    title: "Recognize patterns across real sessions",
    text: "Deep focus, re-ask clusters, cache reuse, and shareable quotes turn raw sessions into operating insight.",
    href: "/case-studies/",
    meta: "3 field stories",
  },
  {
    eyebrow: "Docs",
    title: "Understand the preview build",
    text: "Read the local setup, score formula, signal sources, product surfaces, and parked features.",
    href: "/docs/",
    meta: "Operator manual",
  },
  {
    eyebrow: "Blog",
    title: "Read the product notes",
    text: "Notes on agent telemetry, deterministic scores, local-first design, and why memorable quotes matter.",
    href: "/blog/",
    meta: "Essays",
  },
];
---

<section class="section resource-hub">
  <div class="container">
    <div class="section-narrow hub-head reveal">
      <span class="eyebrow">Product resources</span>
      <h2 class="h2">From raw sessions to operating insight.</h2>
      <p class="lead">
        Learn how the product turns local agent history into score movement,
        day shape, quotes, trends, and next steps you can actually defend.
      </p>
    </div>

    <div class="resource-grid">
      {
        resources.map((item, i) => (
          <a class="resource-card reveal" data-delay={String((i % 3) + 1)} href={item.href}>
            <span class="mono">{item.eyebrow}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <small>{item.meta} →</small>
          </a>
        ))
      }
    </div>
  </div>
</section>
