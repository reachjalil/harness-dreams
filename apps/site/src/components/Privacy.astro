---
const guarantees = [
  {
    title: "Local compute",
    body: "Ingestion, storage, Dream Score math, trends, highlights, and share-card previews run on your Mac.",
  },
  {
    title: "Deterministic scoring",
    body: "Optional local runner text may phrase captions or advice, but it cannot change scores, formulas, or source data.",
  },
  {
    title: "Explicit exports",
    body: "Share cards render only after preview. They include the fields you choose, with quote redaction applied again.",
  },
  {
    title: "No automatic writes",
    body: "Coach cards may suggest a snippet to copy. The preview build does not patch config, open branches, or apply changes.",
  },
];
---

<section class="section" id="privacy">
  <div class="container">
    <div class="privacy card reveal">
      <div class="p-copy">
        <span class="eyebrow">Privacy &amp; trust</span>
        <h2 class="h2">Your agent history stays on your Mac.</h2>
        <p class="lead">
          Agent transcripts include code, paths, secrets, business context, and
          every correction you made. Harness Dreams is designed to deliver
          useful signal before any server is required.
        </p>
        <a class="btn" href="/privacy/">Read the privacy policy</a>
      </div>

      <ul class="g-list">
        {
          guarantees.map((g, i) => (
            <li class="reveal" data-delay={((i % 3) + 1).toString()}>
              <span class="lock" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="5" y="11" width="14" height="9" rx="2" />
                  <path d="M8 11V8a4 4 0 0 1 8 0v3" />
                </svg>
              </span>
              <div>
                <h3>{g.title}</h3>
                <p>{g.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .privacy {
    padding: clamp(1.75rem, 4vw, 2.75rem);
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    background:
      radial-gradient(70% 90% at 0% 0%, rgba(58, 171, 156, 0.08), transparent 55%),
      linear-gradient(180deg, var(--surface), rgba(255, 255, 255, 0));
  }
  .p-copy {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
    align-content: start;
  }
  .g-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.1rem;
  }
  .g-list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.85rem;
    align-items: start;
  }
  .lock {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 9px;
    background: rgba(58, 171, 156, 0.12);
    border: 1px solid var(--line);
    color: var(--good);
    flex: none;
  }
  .g-list h3 {
    font-size: 1rem;
    font-weight: 640;
    margin-bottom: 0.2rem;
  }
  .g-list p {
    color: var(--muted);
    font-size: 0.93rem;
  }
  @media (min-width: 880px) {
    .privacy {
      grid-template-columns: 0.9fr 1.1fr;
    }
    .g-list {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
