---
import BrandMark from "./BrandMark.astro";

const repoUrl = "https://github.com/reachjalil/harness-health";
---

<section class="section cta-section" id="waitlist">
  <div class="container">
    <div class="cta card reveal">
      <div class="starscape cta-stars" aria-hidden="true"></div>
      <div class="mark" aria-hidden="true">
        <BrandMark size={40} moon="#ffffff" orbit="#ffffff" planet="#ffffff" />
      </div>

      <span class="eyebrow">Early access</span>
      <h2 class="cta-title">
        Bring real agent work.<br />
        <span class="grad-night">Help calibrate the intelligence layer.</span>
      </h2>
      <p class="cta-lead">
        The preview needs real Claude Code and Codex history: smooth days,
        expensive loops, useful quotes, and the moments where a workflow finally
        clicked. Join the private preview list.
      </p>

      <form class="waitlist" id="waitlist-form" novalidate>
        <label class="visually-hidden" for="email">Email address</label>
        <input
          id="email"
          name="email"
          type="email"
          inputmode="email"
          autocomplete="email"
          placeholder="you@yourdomain.com"
          required
        />
        <!-- Honeypot: hidden from people, tempting to bots. Leave it empty. -->
        <div class="hp" aria-hidden="true">
          <label for="company">Company</label>
          <input
            id="company"
            name="company"
            type="text"
            tabindex="-1"
            autocomplete="off"
          />
        </div>
        <button class="btn btn-primary" type="submit">Join the waitlist</button>
      </form>
      <p class="form-note" id="form-note" role="status" aria-live="polite">
        No spam: just preview-build notes. Or
        <a href={repoUrl} target="_blank" rel="noreferrer noopener"
        >follow along on GitHub</a
        > / <a href="/start/">request early access</a>.
      </p>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding-block: clamp(3rem, 7vw, 6rem);
  }
  .cta {
    position: relative;
    overflow: hidden;
    padding: clamp(2.75rem, 6vw, 4.5rem);
    display: grid;
    gap: 1.15rem;
    justify-items: center;
    text-align: center;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 28px;
    background:
      radial-gradient(60% 80% at 50% -10%, rgba(167, 139, 250, 0.4), transparent 60%),
      radial-gradient(55% 60% at 12% 0%, rgba(74, 108, 247, 0.28), transparent 55%),
      radial-gradient(70% 55% at 50% 118%, rgba(226, 233, 255, 0.2), transparent 62%),
      linear-gradient(180deg, var(--night), var(--night-2));
    box-shadow: var(--shadow);
  }
  .cta-stars {
    mask-image: radial-gradient(85% 85% at 50% 32%, #000, transparent 88%);
  }
  .mark {
    position: relative;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    margin-bottom: 0.3rem;
  }
  .eyebrow {
    position: relative;
    color: var(--gold-bright);
  }
  .cta-title {
    position: relative;
    font-size: clamp(1.95rem, 5vw, 3.05rem);
    font-weight: 540;
    letter-spacing: -0.022em;
    line-height: 1.08;
    color: #ffffff;
  }
  .grad-night {
    background: linear-gradient(100deg, #ffffff, var(--gold-bright) 78%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .cta-lead {
    position: relative;
    color: rgba(255, 255, 255, 0.72);
    max-width: 46ch;
    font-size: clamp(1.02rem, 2.2vw, 1.15rem);
    line-height: 1.5;
  }
  .waitlist {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: center;
    width: min(100%, 30rem);
    margin-top: 0.4rem;
  }
  input[type="email"] {
    flex: 1 1 16rem;
    padding: 0.78rem 1rem;
    border-radius: 11px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.06);
    color: #ffffff;
    font-family: inherit;
    font-size: 0.97rem;
  }
  input[type="email"]::placeholder {
    color: rgba(255, 255, 255, 0.45);
  }
  input[type="email"]:focus-visible {
    outline: 3px solid rgba(74, 108, 247, 0.5);
    outline-offset: 1px;
    border-color: var(--dusk);
  }
  .waitlist button {
    flex: 0 0 auto;
    background: #fff;
    color: var(--night);
    box-shadow: 0 16px 40px -20px rgba(2, 5, 18, 0.8);
  }
  .waitlist button:hover {
    background: rgba(255, 255, 255, 0.92);
    color: var(--night);
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .form-note {
    position: relative;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.86rem;
  }
  .form-note a {
    color: var(--teal);
  }
  .form-note.ok {
    color: var(--teal);
  }
  .form-note.err {
    color: #ff9b8b;
  }
</style>

<script>
  // Waitlist capture. If a backend endpoint is configured, POST there.
  // Otherwise fall back to noting interest on-device and pointing to GitHub —
  // honest about the fact that no server received it yet.
  const FORM_ENDPOINT = "/api/waitlist"; // Cloudflare Worker (worker/index.ts)

  const form = document.getElementById("waitlist-form") as HTMLFormElement | null;
  const note = document.getElementById("form-note");
  const input = document.getElementById("email") as HTMLInputElement | null;
  const honeypot = document.getElementById("company") as HTMLInputElement | null;

  function setNote(msg: string, kind: "" | "ok" | "err") {
    if (!note) return;
    note.textContent = msg;
    note.classList.remove("ok", "err");
    if (kind) note.classList.add(kind);
  }

  const valid = (v: string) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const email = input?.value.trim() ?? "";
    if (!valid(email)) {
      setNote("Please enter a valid email address.", "err");
      input?.focus();
      return;
    }

    if (FORM_ENDPOINT) {
      try {
        const res = await fetch(FORM_ENDPOINT, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            email,
            company: honeypot?.value ?? "",
            src: "site",
          }),
        });
        if (!res.ok) throw new Error("bad status");
        const data = (await res.json().catch(() => ({}))) as {
          already?: boolean;
        };
        form.reset();
        setNote(
          data.already
            ? "You're already on the list. Talk soon."
            : "You're on the list. Talk soon.",
          "ok"
        );
      } catch {
        setNote("Something went wrong. Please try again or use GitHub.", "err");
      }
      return;
    }

    // No backend yet: record interest locally and be honest about it.
    try {
      const key = "hd:waitlist";
      const list = JSON.parse(localStorage.getItem(key) ?? "[]");
      if (!list.includes(email)) list.push(email);
      localStorage.setItem(key, JSON.stringify(list));
    } catch {
      /* ignore storage errors */
    }
    form.reset();
    setNote("Noted on this device. Star the repo so you do not miss launch.", "ok");
  });
</script>
